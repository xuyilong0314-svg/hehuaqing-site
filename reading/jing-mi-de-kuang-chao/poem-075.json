{
  "id": "poem-075",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">双手合十吧，曼殊说</span><span class=\"poem-line\">我们一起合掌</span><span class=\"poem-line\">所有的黑暗都会被击碎</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">你说光在哪里，室利说</span><span class=\"poem-line\">就在这里</span><span class=\"poem-line\">往你的心轮处更深邃</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/075.webp\" data-caption=\"《阳光》\" aria-label=\"放大欣赏插画《阳光》\"><img src=\"/books/jing-mi-de-kuang-chao/art/075.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《阳光》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《阳光》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 76 页</p>"
}
