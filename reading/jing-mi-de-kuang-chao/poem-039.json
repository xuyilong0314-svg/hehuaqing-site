{
  "id": "poem-039",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">寻一物，沉浸其中</span><span class=\"poem-line\">烦恼散去，拨云见月明</span><span class=\"poem-line\">铅华脱落，心彻底放松</span><span class=\"poem-line\">得此物，执此能虚度</span><span class=\"poem-line\">幸甚至哉</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/039.webp\" data-caption=\"《水滴》\" aria-label=\"放大欣赏插画《水滴》\"><img src=\"/books/jing-mi-de-kuang-chao/art/039.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《水滴》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《水滴》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 39 页</p>"
}
