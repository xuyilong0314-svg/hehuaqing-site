{
  "id": "poem-031",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">切勿</span><span class=\"poem-line\">以你的仅有去否定</span><span class=\"poem-line\">未曾看见的普遍存在</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">塑料制的翅膀</span><span class=\"poem-line\">无法接近太阳</span><span class=\"poem-line\">狂妄自大是熔化的开始</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">请诚</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/031.webp\" data-caption=\"《符号》\" aria-label=\"放大欣赏插画《符号》\"><img src=\"/books/jing-mi-de-kuang-chao/art/031.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《符号》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《符号》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 31 页</p>"
}
