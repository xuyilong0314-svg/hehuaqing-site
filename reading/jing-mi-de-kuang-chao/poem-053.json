{
  "id": "poem-053",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">厨门里散落的光</span><span class=\"poem-line\">烟缭绕</span><span class=\"poem-line\">气腾跃</span><span class=\"poem-line\">火焰明黄</span><span class=\"poem-line\">烟火气与你</span><span class=\"poem-line\">融和人世间的暖意</span><span class=\"poem-line\">静谧处</span><span class=\"poem-line\">蓬勃始</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/053.webp\" data-caption=\"《日出》\" aria-label=\"放大欣赏插画《日出》\"><img src=\"/books/jing-mi-de-kuang-chao/art/053.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《日出》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《日出》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 53 页</p>"
}
