{
  "id": "poem-026",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">心不可无神</span><span class=\"poem-line\">山不可无林</span><span class=\"poem-line\">泉不可无茶</span><span class=\"poem-line\">树不可无鸣</span><span class=\"poem-line\">人不可无癖</span><span class=\"poem-line\">以上皆可无</span><span class=\"poem-line\">唯情不可无你</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/026.webp\" data-caption=\"《对话》\" aria-label=\"放大欣赏插画《对话》\"><img src=\"/books/jing-mi-de-kuang-chao/art/026.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《对话》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《对话》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 26 页</p>"
}
