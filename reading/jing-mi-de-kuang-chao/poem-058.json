{
  "id": "poem-058",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">举起手来</span><span class=\"poem-line\">凝视内心</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">那最热望的希求</span><span class=\"poem-line\">当你以诚相见时</span><span class=\"poem-line\">希求也会凝视你</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">至此</span><span class=\"poem-line\">自信不疑</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/058.webp\" data-caption=\"《莲花生》\" aria-label=\"放大欣赏插画《莲花生》\"><img src=\"/books/jing-mi-de-kuang-chao/art/058.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《莲花生》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《莲花生》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 58 页</p>"
}
