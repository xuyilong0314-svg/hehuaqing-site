{
  "id": "poem-054",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">让我升起了本初</span><span class=\"poem-line\">慈悲力</span><span class=\"poem-line\">随时性</span><span class=\"poem-line\">全然付出</span><span class=\"poem-line\">繁衍与传承</span><span class=\"poem-line\">把能给予的都给予</span><span class=\"poem-line\">普照地</span><span class=\"poem-line\">笼罩着</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/054.webp\" data-caption=\"《根》\" aria-label=\"放大欣赏插画《根》\"><img src=\"/books/jing-mi-de-kuang-chao/art/054.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《根》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《根》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 54 页</p>"
}
