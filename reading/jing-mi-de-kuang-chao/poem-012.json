{
  "id": "poem-012",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">当念绝于此刻</span><span class=\"poem-line\">烦恼剥落</span><span class=\"poem-line\">此身已在清凉园中</span><span class=\"poem-line\">心归梦蝶</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/012.webp\" data-caption=\"《彼岸花》\" aria-label=\"放大欣赏插画《彼岸花》\"><img src=\"/books/jing-mi-de-kuang-chao/art/012.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《彼岸花》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《彼岸花》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 12 页</p>"
}
