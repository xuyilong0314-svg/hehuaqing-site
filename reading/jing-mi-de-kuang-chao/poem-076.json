{
  "id": "poem-076",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">都向我奔袭而来吧</span><span class=\"poem-line\">黄金与徽章</span><span class=\"poem-line\">圆满界中不增减</span><span class=\"poem-line\">世间法中行饶益</span><span class=\"poem-line\">愿菩提心不停歇</span><span class=\"poem-line\">在人间</span><span class=\"poem-line\">在法界</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/076.webp\" data-caption=\"《路》\" aria-label=\"放大欣赏插画《路》\"><img src=\"/books/jing-mi-de-kuang-chao/art/076.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《路》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《路》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 77 页</p>"
}
