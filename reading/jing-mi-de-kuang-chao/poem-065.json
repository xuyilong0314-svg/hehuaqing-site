{
  "id": "poem-065",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">过客</span><span class=\"poem-line\">生命终点</span><span class=\"poem-line\">无法躲藏</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">愿你的旅途</span><span class=\"poem-line\">化为星光的灿烂</span><span class=\"poem-line\">在天空的一隅里</span><span class=\"poem-line\">照耀仍然前行的</span><span class=\"poem-line\">旅人</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/065.webp\" data-caption=\"《星》\" aria-label=\"放大欣赏插画《星》\"><img src=\"/books/jing-mi-de-kuang-chao/art/065.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《星》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《星》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 65 页</p>"
}
