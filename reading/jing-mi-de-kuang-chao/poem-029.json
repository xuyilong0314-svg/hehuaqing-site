{
  "id": "poem-029",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">仙人下落</span><span class=\"poem-line\">遇高山隐雾</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">往深处望去</span><span class=\"poem-line\">钢筋铁骨</span><span class=\"poem-line\">惊诧</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/029.webp\" data-caption=\"《通道》\" aria-label=\"放大欣赏插画《通道》\"><img src=\"/books/jing-mi-de-kuang-chao/art/029.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《通道》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《通道》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 29 页</p>"
}
