{
  "id": "poem-051",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我在液体黄金之中</span><span class=\"poem-line\">看到了梦</span><span class=\"poem-line\">在梦境中看到了你</span><span class=\"poem-line\">云雨之中</span><span class=\"poem-line\">倩影在海底轮奔涌</span><span class=\"poem-line\">一刹那后</span><span class=\"poem-line\">在最山巅走向寂止</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/051.webp\" data-caption=\"《春》\" aria-label=\"放大欣赏插画《春》\"><img src=\"/books/jing-mi-de-kuang-chao/art/051.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《春》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《春》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 51 页</p>"
}
