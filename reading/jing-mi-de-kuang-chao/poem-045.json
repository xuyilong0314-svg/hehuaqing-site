{
  "id": "poem-045",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我想撑着长杆乘着船</span><span class=\"poem-line\">带你穿越这河流</span><span class=\"poem-line\">任风吹过来又打浪</span><span class=\"poem-line\">我想说给你听</span><span class=\"poem-line\">那河的尽头</span><span class=\"poem-line\">有净土流传爱的力量</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/045.webp\" data-caption=\"《吻》\" aria-label=\"放大欣赏插画《吻》\"><img src=\"/books/jing-mi-de-kuang-chao/art/045.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《吻》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《吻》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 45 页</p>"
}
