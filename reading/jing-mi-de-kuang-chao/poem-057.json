{
  "id": "poem-057",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">在长夜的混沌里</span><span class=\"poem-line\">于海底轮中屏息</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">以巧妙的触机</span><span class=\"poem-line\">觉醒坛城的心子</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">窥见新世界</span><span class=\"poem-line\">寂止与光明</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/057.webp\" data-caption=\"《星球》\" aria-label=\"放大欣赏插画《星球》\"><img src=\"/books/jing-mi-de-kuang-chao/art/057.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《星球》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《星球》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 57 页</p>"
}
