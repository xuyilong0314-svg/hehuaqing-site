{
  "id": "poem-036",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">抱紧我</span><span class=\"poem-line\">再靠近些</span><span class=\"poem-line\">往最深处走去</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">在洞中</span><span class=\"poem-line\">观沧海</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">我看见大乐</span><span class=\"poem-line\">及洪波涌起</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/036.webp\" data-caption=\"《乐》\" aria-label=\"放大欣赏插画《乐》\"><img src=\"/books/jing-mi-de-kuang-chao/art/036.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《乐》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《乐》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 36 页</p>"
}
