{
  "id": "poem-055",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">愿你目光至此时</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">去标签</span><span class=\"poem-line\">息疑虑</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">契入密钥</span><span class=\"poem-line\">唯一不变的</span><span class=\"poem-line\">它是万物生的底色</span></p><p class=\"poem-stanza\" id=\"verse-4\"><span class=\"poem-line\">存真意</span><span class=\"poem-line\">不思量</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/055.webp\" data-caption=\"《万物生》\" aria-label=\"放大欣赏插画《万物生》\"><img src=\"/books/jing-mi-de-kuang-chao/art/055.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《万物生》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《万物生》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 55 页</p>"
}
