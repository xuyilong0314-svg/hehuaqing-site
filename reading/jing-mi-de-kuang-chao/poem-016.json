{
  "id": "poem-016",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">原来</span><span class=\"poem-line\">以爱去觉悟</span><span class=\"poem-line\">淡化我执是这般感受</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">这本经</span><span class=\"poem-line\">走向你也走向我</span><span class=\"poem-line\">全，字不好写</span><span class=\"poem-line\">但得笔耕不辍</span><span class=\"poem-line\">这是对生命与爱的双向奔赴</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">莫怪 莫奇怪 莫责怪</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/016.webp\" data-caption=\"《亲密关系》\" aria-label=\"放大欣赏插画《亲密关系》\"><img src=\"/books/jing-mi-de-kuang-chao/art/016.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《亲密关系》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《亲密关系》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 16 页</p>"
}
