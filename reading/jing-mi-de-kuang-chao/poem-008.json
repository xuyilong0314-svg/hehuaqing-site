{
  "id": "poem-008",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">事物的拥有终有极限</span><span class=\"poem-line\">让我们享受每一个刹那</span><span class=\"poem-line\">刹那的狂喜</span><span class=\"poem-line\">切勿让那患得患失得逞</span><span class=\"poem-line\">我身上所有的粒子</span><span class=\"poem-line\">都奔涌向你</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/008.webp\" data-caption=\"《链接》\" aria-label=\"放大欣赏插画《链接》\"><img src=\"/books/jing-mi-de-kuang-chao/art/008.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《链接》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《链接》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 8 页</p>"
}
