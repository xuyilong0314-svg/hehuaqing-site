{
  "id": "poem-018",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">虚度是清欢</span><span class=\"poem-line\">清者，无华也</span><span class=\"poem-line\">心之内恬淡虚无</span><span class=\"poem-line\">于无参照物中取悦</span><span class=\"poem-line\">为常乐</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/018.webp\" data-caption=\"《恒星》\" aria-label=\"放大欣赏插画《恒星》\"><img src=\"/books/jing-mi-de-kuang-chao/art/018.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《恒星》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《恒星》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 18 页</p>"
}
