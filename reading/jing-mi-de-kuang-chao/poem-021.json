{
  "id": "poem-021",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我曾从绝崖走过</span><span class=\"poem-line\">摘下遗世而独立的花</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">在她最美的时候</span><span class=\"poem-line\">我看着她</span><span class=\"poem-line\">她望向我</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">当我心存妄想时</span></p><p class=\"poem-stanza\" id=\"verse-4\"><span class=\"poem-line\">尸陀林的长者告诉我</span><span class=\"poem-line\">孩子阿</span><span class=\"poem-line\">跟我来</span><span class=\"poem-line\">享受这里的腐烂</span><span class=\"poem-line\">也享受这里的灿烂</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/021.webp\" data-caption=\"《遇见》\" aria-label=\"放大欣赏插画《遇见》\"><img src=\"/books/jing-mi-de-kuang-chao/art/021.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《遇见》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《遇见》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 21 页</p>"
}
