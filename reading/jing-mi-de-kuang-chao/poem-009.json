{
  "id": "poem-009",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">不为破镜愁</span><span class=\"poem-line\">破镜之时</span><span class=\"poem-line\">心镜显</span><span class=\"poem-line\">定风波</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/009.webp\" data-caption=\"《雨》\" aria-label=\"放大欣赏插画《雨》\"><img src=\"/books/jing-mi-de-kuang-chao/art/009.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《雨》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《雨》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 9 页</p>"
}
