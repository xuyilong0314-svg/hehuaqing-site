{
  "id": "poem-064",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我愿身居于幽暗</span><span class=\"poem-line\">无声的坛城中</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">召唤众生的业力</span><span class=\"poem-line\">向我奔袭而来</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">无有疲倦地吞噬</span><span class=\"poem-line\">呼出星云万朵</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/064.webp\" data-caption=\"《坛城》\" aria-label=\"放大欣赏插画《坛城》\"><img src=\"/books/jing-mi-de-kuang-chao/art/064.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《坛城》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《坛城》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 64 页</p>"
}
