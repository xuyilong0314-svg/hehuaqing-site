{
  "id": "poem-059",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">把你生疑的底色拿来</span><span class=\"poem-line\">向我坦露</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">我愿显明满弦的弓箭</span><span class=\"poem-line\">予你赤诚</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">洞穿你本性外的屏障</span><span class=\"poem-line\">虚室生白</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/059.webp\" data-caption=\"《门》\" aria-label=\"放大欣赏插画《门》\"><img src=\"/books/jing-mi-de-kuang-chao/art/059.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《门》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《门》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 59 页</p>"
}
