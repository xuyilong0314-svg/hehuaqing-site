{
  "id": "poem-044",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">往风里刻录潜意识</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">遇海起浪</span><span class=\"poem-line\">遇林落花</span><span class=\"poem-line\">遇水涟漪</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">最终入山</span><span class=\"poem-line\">冲散轮回</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/044.webp\" data-caption=\"《风》一\" aria-label=\"放大欣赏插画《风》一\"><img src=\"/books/jing-mi-de-kuang-chao/art/044.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《风》一\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《风》一 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 44 页</p>"
}
