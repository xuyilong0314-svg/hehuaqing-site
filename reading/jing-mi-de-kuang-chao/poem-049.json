{
  "id": "poem-049",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">锋利吗</span><span class=\"poem-line\">你说能斩断过去现在未来</span><span class=\"poem-line\">自此你不会再被时间切割</span><span class=\"poem-line\">你即将成为你当下的怙主</span><span class=\"poem-line\">请你用上最准确的角度</span><span class=\"poem-line\">毫不留情地刺向我的心</span><span class=\"poem-line\">唤醒我</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/049.webp\" data-caption=\"《无明》\" aria-label=\"放大欣赏插画《无明》\"><img src=\"/books/jing-mi-de-kuang-chao/art/049.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《无明》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《无明》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 49 页</p>"
}
