{
  "id": "poem-063",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">修行并非赶路</span><span class=\"poem-line\">好像有一个可以到达的地方</span><span class=\"poem-line\">而是让你学会欣赏</span><span class=\"poem-line\">当你开始欣赏你就到了</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/063.webp\" data-caption=\"《放松》\" aria-label=\"放大欣赏插画《放松》\"><img src=\"/books/jing-mi-de-kuang-chao/art/063.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《放松》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《放松》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 63 页</p>"
}
