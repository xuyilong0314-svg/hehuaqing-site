{
  "id": "poem-006",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">宁选择荒谬的乐观</span><span class=\"poem-line\">不择合理的悲观</span><span class=\"poem-line\">旅程</span><span class=\"poem-line\">已包含生命全部的寓意</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/006.webp\" data-caption=\"《沙漠》\" aria-label=\"放大欣赏插画《沙漠》\"><img src=\"/books/jing-mi-de-kuang-chao/art/006.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《沙漠》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《沙漠》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 6 页</p>"
}
