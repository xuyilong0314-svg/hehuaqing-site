{
  "id": "poem-042",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我聆听着世界的耳语</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">景与你</span><span class=\"poem-line\">你与心</span><span class=\"poem-line\">同时笑了起来</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">你穷尽生命之河灌溉此时</span><span class=\"poem-line\">此时也尽数溶于生命之流</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/042.webp\" data-caption=\"《喜悦》\" aria-label=\"放大欣赏插画《喜悦》\"><img src=\"/books/jing-mi-de-kuang-chao/art/042.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《喜悦》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《喜悦》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 42 页</p>"
}
