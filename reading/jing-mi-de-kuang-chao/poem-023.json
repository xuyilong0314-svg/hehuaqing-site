{
  "id": "poem-023",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">一朵花</span><span class=\"poem-line\">从灿烂到腐烂</span><span class=\"poem-line\">每一步的旅程</span><span class=\"poem-line\">都饱含</span><span class=\"poem-line\">自然与勇敢</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/023.webp\" data-caption=\"《生长》二\" aria-label=\"放大欣赏插画《生长》二\"><img src=\"/books/jing-mi-de-kuang-chao/art/023.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《生长》二\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《生长》二 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 23 页</p>"
}
