{
  "id": "poem-050",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">在文殊的中台</span><span class=\"poem-line\">从碧落中看到</span><span class=\"poem-line\">不远处的将来</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">一群人向正心奔赴</span><span class=\"poem-line\">他们走过的每条路</span><span class=\"poem-line\">绽放无数的智慧花</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/050.webp\" data-caption=\"《蓝莲花》\" aria-label=\"放大欣赏插画《蓝莲花》\"><img src=\"/books/jing-mi-de-kuang-chao/art/050.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《蓝莲花》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《蓝莲花》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 50 页</p>"
}
