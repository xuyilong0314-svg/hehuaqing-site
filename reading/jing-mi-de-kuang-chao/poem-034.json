{
  "id": "poem-034",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">道生一</span><span class=\"poem-line\">一生二</span><span class=\"poem-line\">三生万物</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">时间阿</span><span class=\"poem-line\">你再往前来一点</span><span class=\"poem-line\">满足我这彻夜的满怀的期待</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">在这岛上</span><span class=\"poem-line\">沧海之中</span><span class=\"poem-line\">我等待万物的到来</span></p><p class=\"poem-stanza\" id=\"verse-4\"><span class=\"poem-line\">升起的是月亮或太阳？</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/034.webp\" data-caption=\"《种子》\" aria-label=\"放大欣赏插画《种子》\"><img src=\"/books/jing-mi-de-kuang-chao/art/034.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《种子》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《种子》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 34 页</p>"
}
