{
  "id": "poem-028",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我盘腿于山洞</span><span class=\"poem-line\">于喜马拉雅的大漠中</span><span class=\"poem-line\">看雪</span><span class=\"poem-line\">我在一片圣洁之中</span><span class=\"poem-line\">看到花</span><span class=\"poem-line\">在花中</span><span class=\"poem-line\">见到你</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/028.webp\" data-caption=\"《雪》\" aria-label=\"放大欣赏插画《雪》\"><img src=\"/books/jing-mi-de-kuang-chao/art/028.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《雪》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《雪》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 28 页</p>"
}
