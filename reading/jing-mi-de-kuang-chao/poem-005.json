{
  "id": "poem-005",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">对众生当然要慈悲</span><span class=\"poem-line\">但是先对自己慈悲</span><span class=\"poem-line\">你自己也是众生</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/005.webp\" data-caption=\"《幸福》\" aria-label=\"放大欣赏插画《幸福》\"><img src=\"/books/jing-mi-de-kuang-chao/art/005.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《幸福》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《幸福》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 5 页</p>"
}
