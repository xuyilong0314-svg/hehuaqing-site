{
  "id": "poem-017",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我曾向天的尽头</span><span class=\"poem-line\">抛洒十万恒河沙</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">化为十万条星河</span><span class=\"poem-line\">托付十万个心愿</span></p><p class=\"poem-stanza\" id=\"verse-3\"><span class=\"poem-line\">我深知</span></p><p class=\"poem-stanza\" id=\"verse-4\"><span class=\"poem-line\">星空的存在</span><span class=\"poem-line\">并非用来实现</span><span class=\"poem-line\">而是用以启明</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/017.webp\" data-caption=\"《宇宙》\" aria-label=\"放大欣赏插画《宇宙》\"><img src=\"/books/jing-mi-de-kuang-chao/art/017.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《宇宙》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《宇宙》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 17 页</p>"
}
