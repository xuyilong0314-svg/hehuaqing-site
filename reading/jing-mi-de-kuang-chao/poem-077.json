{
  "id": "poem-077",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">让彼此再靠近一些</span><span class=\"poem-line\">像空气一样</span><span class=\"poem-line\">在此刻</span><span class=\"poem-line\">我们同归于沉默</span><span class=\"poem-line\">立足于不败之地</span><span class=\"poem-line\">当下之中</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/077.webp\" data-caption=\"《对话》\" aria-label=\"放大欣赏插画《对话》\"><img src=\"/books/jing-mi-de-kuang-chao/art/077.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《对话》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《对话》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 78 页</p>"
}
