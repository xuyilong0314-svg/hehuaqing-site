{
  "id": "poem-010",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">菩萨的天赋是爱</span><span class=\"poem-line\">爱他的轮回</span><span class=\"poem-line\">爱他的众生</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/010.webp\" data-caption=\"《温暖》\" aria-label=\"放大欣赏插画《温暖》\"><img src=\"/books/jing-mi-de-kuang-chao/art/010.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《温暖》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《温暖》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 10 页</p>"
}
