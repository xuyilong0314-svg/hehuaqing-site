{
  "id": "poem-014",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">心在尘世漂</span><span class=\"poem-line\">既是飘</span><span class=\"poem-line\">见风缭乱也应该</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/014.webp\" data-caption=\"《风》二\" aria-label=\"放大欣赏插画《风》二\"><img src=\"/books/jing-mi-de-kuang-chao/art/014.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《风》二\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《风》二 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 14 页</p>"
}
