{
  "id": "poem-019",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我愿一生都遵从</span><span class=\"poem-line\">臣服于当下之中</span><span class=\"poem-line\">请接受我袒露的贪心</span><span class=\"poem-line\">我只想摈弃一切纷扰</span><span class=\"poem-line\">静静地看着你</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/019.webp\" data-caption=\"《眼睛》\" aria-label=\"放大欣赏插画《眼睛》\"><img src=\"/books/jing-mi-de-kuang-chao/art/019.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《眼睛》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《眼睛》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 19 页</p>"
}
