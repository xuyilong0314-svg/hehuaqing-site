{
  "id": "poem-052",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">茶里的雾气升腾</span><span class=\"poem-line\">飘向我</span><span class=\"poem-line\">奔向你</span><span class=\"poem-line\">融于空性</span><span class=\"poem-line\">将眉间与心</span><span class=\"poem-line\">用上亘古的洪荒</span><span class=\"poem-line\">全然地</span><span class=\"poem-line\">无疑的</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/052.webp\" data-caption=\"《发》\" aria-label=\"放大欣赏插画《发》\"><img src=\"/books/jing-mi-de-kuang-chao/art/052.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《发》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《发》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 52 页</p>"
}
