{
  "id": "poem-048",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">女人的胸</span><span class=\"poem-line\">珠峰上的雪</span><span class=\"poem-line\">都很白</span><span class=\"poem-line\">从远古到现在</span><span class=\"poem-line\">白了很多很多年</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/048.webp\" data-caption=\"《源》\" aria-label=\"放大欣赏插画《源》\"><img src=\"/books/jing-mi-de-kuang-chao/art/048.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《源》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《源》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 48 页</p>"
}
