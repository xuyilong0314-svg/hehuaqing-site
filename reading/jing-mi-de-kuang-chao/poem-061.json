{
  "id": "poem-061",
  "body": "<div class=\"poem-text\"><p class=\"poem-stanza\" id=\"verse-1\"><span class=\"poem-line\">我把秘密倾倒进云海</span><span class=\"poem-line\">溅起漫天的啤酒花</span><span class=\"poem-line\">一饮而尽在胃里</span><span class=\"poem-line\">醉后陶然</span><span class=\"poem-line\">云消散</span></p><p class=\"poem-stanza\" id=\"verse-2\"><span class=\"poem-line\">在星光市集上</span><span class=\"poem-line\">风将你的身影</span><span class=\"poem-line\">隐入夜的迷离</span></p></div><figure class=\"poem-illustration\"><button type=\"button\" class=\"poem-art-open\" data-poem-art=\"/books/jing-mi-de-kuang-chao/art/061.webp\" data-caption=\"《泡泡》\" aria-label=\"放大欣赏插画《泡泡》\"><img src=\"/books/jing-mi-de-kuang-chao/art/061.webp\" width=\"885\" height=\"1050\" alt=\"亮子绘制的原书插画《泡泡》\" loading=\"lazy\" decoding=\"async\"/></button><figcaption>《泡泡》 · 亮子<span>轻触画面，放大欣赏</span></figcaption></figure><p class=\"poem-original-page\">原书第 61 页</p>"
}
